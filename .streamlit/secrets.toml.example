# Streamlit secrets example for Job-CV Matcher & Tailor
# Copy this file to .streamlit/secrets.toml and fill in real values.

# ── Paid-plan AI provider keys (users supply their own on BYO-key plan) ──────
openai_api_key = ""
codex_api_key  = ""
gemini_api_key = ""
groq_api_key   = ""

# ── PayPal credentials ────────────────────────────────────────────────────────
# Use sandbox.paypal.com for testing, api-m.paypal.com for production.
PAYPAL_CLIENT_ID     = ""
PAYPAL_CLIENT_SECRET = ""
# Base URL for your deployed app (used for PayPal return/cancel URLs)
APP_BASE_URL = "https://jobcv.luilver.com"   # confirmation links are {APP_BASE_URL}/confirm?verify=...
# Switch to live endpoint for production:
# PAYPAL_API_BASE = "https://api-m.paypal.com"

# ── Free-tier AI (platform-owned key) ────────────────────────────────────────
# This key is used invisibly for the 3 free-trial analyses.
# Falls back to openai_api_key if not set (convenient for local dev).
PLATFORM_OPENAI_API_KEY = ""

# ── Outbound email (SMTP) ─────────────────────────────────────────────────────
# New accounts must confirm their email address before they can log in.
#
# Option 1 — Google Workspace SMTP: requires a 16-character App Password
#   (Google Account -> Security -> 2-Step Verification -> App passwords). App
#   passwords are admin-controlled, so they are unavailable when the domain is on
#   the free Cloud Identity tier or the admin disabled them.
#
# Option 2 — a transactional relay (Resend / Brevo / SES …), no Google policy
#   involved. Verify luilver.com as a sending domain (SPF + DKIM) with the
#   provider; then the FROM address stays jobcv@luilver.com.
#   Resend: SMTP_HOST=smtp.resend.com, SMTP_USER=resend, password = API key
#   Brevo:  SMTP_HOST=smtp-relay.brevo.com, SMTP_USER=<login>, password = SMTP key
#
# The app also uses APP_BASE_URL (above) to build the confirmation link.
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 465                # 465 = implicit TLS (SMTP_SSL); use 587 + SMTP_USE_STARTTLS
SMTP_USER = "jobcv@luilver.com"
SMTP_APP_PASSWORD = ""         # Google App Password or relay SMTP key — required
SMTP_FROM = "jobcv@luilver.com"
SMTP_FROM_NAME = "Job-CV AI Generator"
SMTP_USE_STARTTLS = false
